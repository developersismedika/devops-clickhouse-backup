# Sismedika ClickHouse Backup - example
CLICKHOUSE_MODE="docker"
CLICKHOUSE_CONTAINER="his-transformer-clickhouse"
CLICKHOUSE_HOST="127.0.0.1"
CLICKHOUSE_PORT="9000"
CLICKHOUSE_USER="clickhouse"
CLICKHOUSE_PASSWORD="CHANGE_ME"
CLICKHOUSE_CONNECT_TIMEOUT="10"
CLICKHOUSE_SEND_TIMEOUT="3600"
CLICKHOUSE_RECEIVE_TIMEOUT="3600"

BACKUP_SCOPE="databases"
BACKUP_DATABASE="his_transformer"
BACKUP_DATABASES="bronze primaya"

# s3 | rsync
BACKUP_BACKEND="s3"

# rsync backend
LOCAL_BACKUP_ROOT="/opt/sismedika-clickhouse-backup/var/data"
RSYNC_REMOTE_HOST="10.0.0.20"
RSYNC_REMOTE_USER="backup"
RSYNC_REMOTE_PORT="22"
RSYNC_REMOTE_PATH="/srv/backup/clickhouse/his-transformer"
RSYNC_SSH_KEY="/root/.ssh/clickhouse-backup"
RSYNC_EXTRA_OPTS="-aH --delete-delay"

S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="CHANGE_ME"
S3_PREFIX="his-transformer"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

FULL_BACKUP_DAY="7"
BACKUP_TIME="02:00"
SYSTEMD_RANDOMIZED_DELAY="5m"

OTLP_ENABLED="true"
OTLP_KEY="CHANGE_ME"
LOGSEND_ENDPOINT="http://signoz.example.local:4318"
LOGSEND_PATH="/opt/sismedika-clickhouse-backup/bin/logsend-clickhouse-backup"
OTLP_AUTH_MODE="header"
OTLP_HEADER_NAME="X-Tenant-Key"
LOGSEND_SPOOL_DIR="/opt/sismedika-clickhouse-backup/var/spool"

LOG_DIR="/opt/sismedika-clickhouse-backup/var"

UPDATE_BASE_URL="https://raw.githubusercontent.com/developersismedika/devops-clickhouse-backup/main"

BACKUP_TIMEOUT_SEC="0"
